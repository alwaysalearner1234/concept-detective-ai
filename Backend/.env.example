[TEMPLATE]
# Copy this file to .env and fill in your key to enable LIVE AI mode.
# If ANTHROPIC_API_KEY is left blank, the app automatically runs in
# MOCK/DEMO mode using built-in canned case data -- fully functional,
# zero API cost, perfect for offline demoing.

ANTHROPIC_API_KEY=

# Any Claude model your key has access to. Defaults to a stable snapshot.
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Comma-separated list of allowed frontend origins.
# Use your Netlify frontend origin in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://concept-detective.netlify.app

# Optional regex for Netlify deploy preview/custom frontend domains.
# Matches: https://random-preview--concept-detective.netlify.app
CORS_ORIGIN_REGEX=^https://[a-z0-9-]+--concept-detective\.netlify\.app$
